# Supabase
# Obter em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key

# OpenAI
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Stripe
# Obter em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — Mensais (criar no dashboard do Stripe em Products)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_EXTRA_LOCATION=price_...

# Stripe Price IDs — Anuais (opcional: 10× o valor mensal, 2 meses grátis)
# Criar no Stripe: Products → cada plano → Add price → Recurring → Yearly
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# WhatsApp 1-click approval token secret (gere com: openssl rand -hex 32)
APPROVAL_SECRET=gere-uma-string-aleatoria-hex-aqui

# Upstash Redis
# Obter em: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Upstash QStash
# Obter em: https://console.upstash.com/qstash
QSTASH_TOKEN=...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Evolution API (WhatsApp) — opcional
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_API_KEY=your_evolution_api_key

# Resend (email)
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@seudominio.com

# Google OAuth (para Google My Business)
# Obter em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Facebook OAuth (para importar e responder avaliações de Páginas do Facebook)
# Obter em: https://developers.facebook.com/apps — criar App tipo Business
# Permissões necessárias: pages_read_engagement, pages_read_user_content, pages_manage_engagement, pages_show_list
# ATENÇÃO: pages_manage_posts foi descontinuada — use pages_manage_engagement
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=gere-uma-string-aleatoria-longa-aqui
